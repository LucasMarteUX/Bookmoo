# GEMINI_API_KEY: Used for all Gemini features (vocabulary explanations, TTS, comic page generation).
# Set in .env.local for local development. AI Studio may inject it at runtime from secrets.
# The app runs without it (no blank screen); IA features will show a message asking you to configure the key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Deploy no Supabase Storage (npm run deploy:supabase). Dashboard → Project Settings → API.
SUPABASE_URL="https://seu-projeto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Auth e sync no frontend (obrigatório para login/cadastro e dados por usuário).
# Em .env.local use as variáveis com prefixo VITE_ para o app React.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-anon-key"
